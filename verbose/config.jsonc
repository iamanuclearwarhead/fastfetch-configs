{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    // verbose — everything fastfetch knows, neatly grouped, Nerd Font icons
    "logo": {
        "padding": {
            "top": 1
        }
    },
    "display": {
        "separator": " \u001b[35m\u001b[0m ",
        "color": {
            "keys": "35"
        }
    },
    "modules": [
        "break",
        {
            "type": "title",
            "format": "\u001b[1;35m{user-name}\u001b[0m\u001b[90m@\u001b[0m\u001b[1;35m{host-name}"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[1;35m SYSTEM\u001b[0m \u001b[90m──────────────────"
        },
        {
            "type": "os",
            "key": "   "
        },
        {
            "type": "host",
            "key": " 󰌢  "
        },
        {
            "type": "kernel",
            "key": "   "
        },
        {
            "type": "uptime",
            "key": " 󰔛  "
        },
        {
            "type": "packages",
            "key": " 󰏖  "
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[1;35m DESKTOP\u001b[0m \u001b[90m─────────────────"
        },
        {
            "type": "de",
            "key": "   "
        },
        {
            "type": "wm",
            "key": "   "
        },
        {
            "type": "theme",
            "key": " 󰉼  "
        },
        {
            "type": "icons",
            "key": " 󰀻  "
        },
        {
            "type": "font",
            "key": "   "
        },
        {
            "type": "cursor",
            "key": " 󰇀  "
        },
        {
            "type": "display",
            "key": " 󰍹  "
        },
        {
            "type": "shell",
            "key": "   "
        },
        {
            "type": "terminal",
            "key": "   "
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[1;35m HARDWARE\u001b[0m \u001b[90m────────────────"
        },
        {
            "type": "cpu",
            "key": "   "
        },
        {
            "type": "gpu",
            "key": " 󰢮  "
        },
        {
            "type": "memory",
            "key": "   "
        },
        {
            "type": "swap",
            "key": " 󰓡  "
        },
        {
            "type": "disk",
            "key": " 󰋊  "
        },
        {
            "type": "battery",
            "key": " 󰁹  "
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        },
        "break"
    ]
}
