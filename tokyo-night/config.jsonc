{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    // tokyo-night — neon purple & blue (true color), Nerd Font icons
    "logo": {
        "padding": {
            "top": 1
        }
    },
    "display": {
        "separator": " \u001b[38;2;187;154;247m\u001b[0m ",
        "color": {
            "keys": "38;2;122;162;247"
        }
    },
    "modules": [
        "break",
        {
            "type": "title",
            "format": "\u001b[1;38;2;187;154;247m{user-name}\u001b[0m\u001b[38;2;86;95;137m@\u001b[0m\u001b[1;38;2;122;162;247m{host-name}"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;86;95;137m─────────\u001b[38;2;187;154;247m 󰥔 \u001b[38;2;86;95;137m─────────"
        },
        {
            "type": "os",
            "key": "  "
        },
        {
            "type": "kernel",
            "key": "  "
        },
        {
            "type": "packages",
            "key": " 󰏖 "
        },
        {
            "type": "shell",
            "key": "  "
        },
        {
            "type": "terminal",
            "key": "  "
        },
        {
            "type": "wm",
            "key": "  "
        },
        {
            "type": "cpu",
            "key": "  "
        },
        {
            "type": "gpu",
            "key": " 󰢮 "
        },
        {
            "type": "memory",
            "key": "  "
        },
        {
            "type": "uptime",
            "key": "  "
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;86;95;137m─────────\u001b[38;2;187;154;247m 󰥔 \u001b[38;2;86;95;137m─────────"
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        },
        "break"
    ]
}
