{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    // matrix — all-green hacker terminal aesthetic, Nerd Font icons
    "logo": {
        "color": {
            "1": "green",
            "2": "green"
        },
        "padding": {
            "top": 1
        }
    },
    "display": {
        "separator": " \u001b[32m>>\u001b[0m ",
        "color": {
            "keys": "32",
            "output": "92"
        }
    },
    "modules": [
        "break",
        {
            "type": "title",
            "format": "\u001b[1;32m[ {user-name}@{host-name} ]"
        },
        {
            "type": "custom",
            "format": "\u001b[32m░▒▓█████████████████████▓▒░"
        },
        {
            "type": "os",
            "key": "  os"
        },
        {
            "type": "kernel",
            "key": "  kernel"
        },
        {
            "type": "packages",
            "key": " 󰏖 pkgs"
        },
        {
            "type": "shell",
            "key": "  shell"
        },
        {
            "type": "terminal",
            "key": "  tty"
        },
        {
            "type": "cpu",
            "key": "  cpu"
        },
        {
            "type": "memory",
            "key": "  mem"
        },
        {
            "type": "processes",
            "key": " 󰅵 procs"
        },
        {
            "type": "localip",
            "key": " 󰩟 ip"
        },
        {
            "type": "uptime",
            "key": "  up"
        },
        {
            "type": "custom",
            "format": "\u001b[32m░▒▓█████████████████████▓▒░"
        },
        "break"
    ]
}
