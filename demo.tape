# vhs demo tape — regenerate with: vhs demo.tape
# https://github.com/charmbracelet/vhs

Output assets/demo.gif

Set Theme "Catppuccin Mocha"
Set FontFamily "JetBrainsMono Nerd Font"
Set FontSize 15
Set Width 1200
Set Height 700
Set Padding 16
Set TypingSpeed 40ms

Type "./install.sh -l"
Enter
Sleep 2.5s

Type "clear"
Enter

Type "./install.sh -p tokyo-night"
Enter
Sleep 3s

Type "clear"
Enter

Type "./install.sh -p nordic"
Enter
Sleep 3s

Type "clear"
Enter

Type "./install.sh -p matrix"
Enter
Sleep 3.5s
