{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    // sgobex — clean blue/gray layout with image logo (Kitty/WezTerm) and pacman package count
    "logo": {
        "source": "./logo.png",
        "type": "kitty",
        "height": 18,
        "padding": {
            "top": 2
        }
    },
    "display": {
        "separator": " \u001b[34m\u001b[0m "
    },
    "modules": [
        "break",
        "break",
        {
            "type": "title",
            "keyWidth": 10
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[34m◆ \u001b[90m─────────────────────── \u001b[34m◆"
        },
        {
            "type": "os",
            "key": " ",
            "keyColor": "34"
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "34"
        },
        {
            "type": "command",
            "shell": "/bin/sh",
            "text": "echo \"$(pacman -Q | wc -l) (pacman)\"",
            "key": " ",
            "keyColor": "34"
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "34"
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "34"
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "34"
        },
        {
            "type": "cpu",
            "format": "Intel 13th Gen i7-1355U",
            "key": " ",
            "keyColor": "34"
        },
        {
            "type": "gpu",
            "format": "Intel Iris Xe [Int]",
            "key": "󰢮 ",
            "keyColor": "34"
        },
        {
            "type": "memory",
            "key": " ",
            "keyColor": "34"
        },
        {
            "type": "uptime",
            "key": " ",
            "keyColor": "34"
        },
        {
            "type": "datetime",
            "format": "{11}/{3}/{1}",
            "key": " ",
            "keyColor": "34"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[34m◆ \u001b[90m─────────────────────── \u001b[34m◆"
        },
        "break",
        "break"
    ]
}
