{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    // minimal — no Nerd Font needed, works in any terminal
    "logo": {
        "type": "small",
        "padding": {
            "top": 1
        }
    },
    "display": {
        "separator": "  "
    },
    "modules": [
        "break",
        {
            "type": "title",
            "format": "{user-name}@{host-name}"
        },
        {
            "type": "custom",
            "format": "───────────────"
        },
        "os",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "memory",
        "break"
    ]
}
