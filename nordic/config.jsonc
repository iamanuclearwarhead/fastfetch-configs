{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    // nordic — cool Nord-inspired blues, Nerd Font icons
    "logo": {
        "padding": {
            "top": 1
        }
    },
    "display": {
        "separator": " \u001b[36m\u001b[0m  "
    },
    "modules": [
        "break",
        {
            "type": "title",
            "format": "\u001b[1;36m{user-name}\u001b[0m\u001b[90m@\u001b[0m\u001b[1;34m{host-name}"
        },
        {
            "type": "custom",
            "format": "\u001b[36m╭──────────────────────────╮"
        },
        {
            "type": "os",
            "key": "\u001b[36m│ \u001b[34m "
        },
        {
            "type": "kernel",
            "key": "\u001b[36m│ \u001b[34m "
        },
        {
            "type": "packages",
            "key": "\u001b[36m│ \u001b[34m󰏖 "
        },
        {
            "type": "shell",
            "key": "\u001b[36m│ \u001b[34m "
        },
        {
            "type": "terminal",
            "key": "\u001b[36m│ \u001b[34m "
        },
        {
            "type": "wm",
            "key": "\u001b[36m│ \u001b[34m "
        },
        {
            "type": "cpu",
            "key": "\u001b[36m│ \u001b[34m "
        },
        {
            "type": "gpu",
            "key": "\u001b[36m│ \u001b[34m󰢮 "
        },
        {
            "type": "memory",
            "key": "\u001b[36m│ \u001b[34m "
        },
        {
            "type": "uptime",
            "key": "\u001b[36m│ \u001b[34m "
        },
        {
            "type": "custom",
            "format": "\u001b[36m╰──────────────────────────╯"
        },
        "break"
    ]
}
