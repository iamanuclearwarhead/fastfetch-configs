// desc: soft mauve and pink pastels (nerd font, truecolor)
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    // catppuccin — soft mauve & pink pastels (true color), Nerd Font icons
    "logo": {
        "padding": {
            "top": 1
        }
    },
    "display": {
        "separator": " \u001b[38;2;203;166;247m󰄾\u001b[0m ",
        "color": {
            "keys": "38;2;245;194;231"
        }
    },
    "modules": [
        "break",
        {
            "type": "title",
            "format": "\u001b[1;38;2;203;166;247m{user-name}\u001b[0m \u001b[38;2;108;112;134m~\u001b[0m \u001b[1;38;2;245;194;231m{host-name}"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;203;166;247m  ────────────────────  "
        },
        {
            "type": "os",
            "key": "  "
        },
        {
            "type": "kernel",
            "key": "  "
        },
        {
            "type": "packages",
            "key": " 󰏖 "
        },
        {
            "type": "shell",
            "key": "  "
        },
        {
            "type": "terminal",
            "key": "  "
        },
        {
            "type": "wm",
            "key": "  "
        },
        {
            "type": "cpu",
            "key": "  "
        },
        {
            "type": "gpu",
            "key": " 󰢮 "
        },
        {
            "type": "memory",
            "key": "  "
        },
        {
            "type": "uptime",
            "key": " 󰔛 "
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;203;166;247m  ────────────────────  "
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 3,
            "symbol": "circle"
        },
        "break"
    ]
}
